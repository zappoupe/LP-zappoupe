# ─────────────────────────────────────────────────────────────
#  ZapPoupe — template de variáveis de ambiente
#
#  Este arquivo VAI pro Git (é só o molde, sem segredo nenhum).
#  Pra rodar o projeto:
#     cp .env.example .env
#  e preencha os valores no .env, que é ignorado pelo Git.
# ─────────────────────────────────────────────────────────────

# ⚠️  Tudo com prefixo VITE_ é embutido no bundle e fica visível
#     pra qualquer visitante. Só chave pública aqui:
#       Stripe   → pk_...  (nunca sk_...)
#       Supabase → anon    (nunca service_role)

# Stripe → Developers → API keys → Publishable key
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase → Settings → API → Project URL (sem barra no final)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase → Settings → API → anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx

# Base das Edge Functions (sem barra no final).
# O checkout chama ${VITE_SUPABASE_FUNCTIONS_URL}/checkout-session
VITE_SUPABASE_FUNCTIONS_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/functions/v1
